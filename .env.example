# 复制这个文件为 .env，填上你自己的 key
# 不填也能跑：程序会进入"回放模式"，用规则模拟决策，
# 完整循环（意图→工具→观察→自检→记忆）一步不少。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 退役，用了会报错
DEEPSEEK_MODEL=deepseek-flash

# ---- 推理模型行为（2026-10 起 deepseek-flash 是推理模型，必须看这段）----
# 它会先输出 reasoning_content 再输出 content，两者共享 max_tokens 预算。
#   auto  跟随模型默认（推荐）
#   off   关闭思考。快一倍，但复杂判断会退化（意图分类实测会判错）
LLM_THINKING=auto
# 留空 = 用服务端默认档。可选 low / high。
# 不要填 max：实测 4000 token 全被思考吃光，正文 0 字。
LLM_EFFORT=

# 各环节 token 预算。推理模型的思考会占掉 30%~60%，所以不能按"正文长度"估。
TOK_INTENT=400
TOK_DECOMPOSE=800
TOK_SLOTS=1200
TOK_DECIDE=1600
TOK_JUDGE=1200
TOK_GENERATE=4000
TOK_VERIFY=4000
TOK_ASK=400
# 读图：字段 + 每字段一句原文依据 + 未识别列表，比纯抽槽位长
TOK_VISION=1600

# 答案自检策略
#   rule        纯规则（默认，零成本，抓得住「无依据引用」这类确定性错误）
#   rule_first  规则先跑，报错时再叫模型复核（更严，但每条多花 30 秒）
#   llm         每次都叫模型（最慢，排查语义问题时用）
VERIFY_MODE=rule

# 检索后端：bm25（默认，零依赖） / embedding（后续版本接入）
RETRIEVAL_BACKEND=bm25
RETRIEVAL_TOP_K=5

# Agent 硬预算，别调太大，否则演示时容易卡住
MAX_AGENT_STEPS=8
MAX_AGENT_SECONDS=60

# ================== 账号与权限（v20 新增）==================
# 只装了 pydantic 也能用的密码方案：PBKDF2-HMAC-SHA256（标准库 hashlib）。
# 库里只存「盐 + 哈希」，只存令牌的 sha256，泄库不等于能被登录。
PBKDF2_ITER=600000
# 登录态有效期（小时）。默认 3 天，且不滑动续期——
# 续期会让「管理员封号」的生效时间取决于用户活跃度，反而不好解释。
TOKEN_TTL_HOURS=72
TOKEN_NAME=law_token

# 开放注册。设为 0 则只能由管理员在后台建号（/api/auth/register 直接 403）。
ALLOW_REGISTER=1
# 同 IP 每小时最多注册几个号。开放注册必然招灌水，一张表灌满后后台翻页都翻不动。
REG_PER_IP_HOUR=3

# 登录失败锁定，两个维度分开算，任一触发就拒：
#   同账号连错 5 次 → 锁 15 分钟（防定向爆破）
#   同 IP 10 分钟内错 8 次 → 锁 10 分钟（防撞库）
LOGIN_FAIL_ACCOUNT=5
LOGIN_LOCK_MIN=15
LOGIN_FAIL_IP=8
LOGIN_IP_WINDOW_MIN=10

PWD_MIN=8
PWD_MAX=128

# 首个管理员。首次启动时若库里一个 admin 都没有，就用它建号。
# ADMIN_PASSWORD 留空 = 随机生成一次性密码并打印到控制台（只打印一次）。
# 不写死默认密码：写死了等于交付物里带一个后门。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Cookie 是否只在 HTTPS 下发送。
# 本地 http://127.0.0.1 必须保持 0，否则浏览器直接不保存 cookie，
# 表现为「登录成功但立刻又退出登录」——从现象很难反推原因。部署 https 后再改 1。
SECURE_COOKIE=0

# 是否信任 X-Forwarded-For。默认不信任：本地直连时这头可以随便伪造，
# 信了等于把登录限流拱手让出（每次换个 XFF 就绕过）。只有挂在 nginx/网关后才开。
TRUST_PROXY=0

# ================== 以下一般不用动 ==================
# 这一段是「代码会读、但这个文件以前没写」的键。不写也能跑，写在这里是为了
# 让想调的人知道它存在——清单里没有的开关，等于不存在。
#
# 换语料文件位置。不写 = 自动选 data/statutes.jsonl，没有则退回示例语料。
# 指到别的文件有两个用处：把语料放到别的盘；以及**不挪动真实文件**地模拟
# 「正式语料缺失」（缺语料时登录页会挂告警，不会假装正常）。
# LAW_CORPUS_PATH=
#
# 换数据库位置。不写 = data/law.db。
# LAW_DB_PATH=
#
# 降级（key 失效、余额不足）之后，隔多久允许再试一次在线，单位秒。
# 太短会在没钱时反复打接口，太长会让充值后还要干等。
LLM_RECOVER_AFTER=600
#
# 单次问答的 token 总上限（含思考过程）。推理模型的思考常吃掉 30%~60%，
# 所以别按「正文多长」估这个值。
MAX_AGENT_TOKENS=60000
# 自检没过、重试一次时的 token 上限。
TOK_RETRY_CAP=8000
#
# 通用民事法（民法典、合同法）的检索降权系数，1.0 = 不降权。
# 收这两部是为了版本感知，代价是把劳动法条文挤出检索前列，所以默认降权。
GENERIC_BOOST=0.55
#
# CSRF 防护用的 cookie 名。多实例同域部署时必须错开，否则互相覆盖。
CSRF_NAME=law_csrf
#
# 服务监听端口。默认 8000。两种启动方式都认它：
#   · 双击 启动-网页.bat / 启动-命令行.bat：bat 里 `set "PORT=8000"` 是同一来源，
#     且启动前会先查端口被占就直接退出
#   · 直接 `python app/server.py` 起：server.py 的 __main__ 用 os.environ.get("PORT", 8000)
# 想换端口：主要方式改 .bat 的 PORT（见交付说明 FAQ）；直接起才改这里或 .env。
# PORT=8000

# ---- 判例检索与联网（v118）----
# 外部检索的「允许开关」。默认 0：纯本地、离线可用。
# 设 1 之后还需同时满足：检测到网络可用 + 调用方显式请求
# （接口带 external=1，或网页上点「联网补充线索」）才会真的发请求。
# 所以「自动检测网络」不等于「自动联网」，默认包不会悄悄往外发包。
CASE_SEARCH_ADAPTER=0
#
# 网络自动检测模式：auto（默认，后台探一次 TCP 并缓存）/ online / offline。
# 后两个是强制模式、不探测，给演示与回归用。探测目标默认取 DEEPSEEK_BASE_URL
# 的主机；只握手不发包，不发送任何提问内容；任何异常一律按离线。
LAW_NET_MODE=auto
# 留空＝跟随 DEEPSEEK_BASE_URL 的主机；也可填自己的网关或 IP 绕过 DNS。
# LAW_NET_PROBE_HOST=
LAW_NET_PROBE_PORT=443
LAW_NET_TIMEOUT_MS=800
# 探测结论缓存秒数。成功和失败都缓存，断网时不会每问一句都重探一次。
LAW_NET_TTL=300
#
# 外部检索源 URL 模板，{q} 会被 URL 编码后的提问替换。只认
# {"items":[{"title","url","snippet"}]} 这种 JSON，不猜网页 DOM。
# 留空＝允许联网也不发请求，界面会明说「未配置检索源」。
# 只允许 https；本地回环 http 仅供离线端到端测试。
# LAW_CASE_SEARCH_URL=
LAW_CASE_SEARCH_TIMEOUT_MS=2500
